[Unit]
Description=Archivematica MCPServer
After=syslog.target network.target mysql.service

[Service]
Type=simple
User=archivematica
EnvironmentFile=/etc/default/archivematica-mcp-server
ExecStart=/usr/share/archivematica/virtualenvs/archivematica/bin/python -m archivematica.MCPServer.archivematicaMCP

[Install]
WantedBy=multi-user.target
