#!/usr/bin/env bash

set -uo pipefail

if [[ $# -lt 2 ]]; then
    echo "Usage: $0 OUTPUT_DIRECTORY SERVICE [SERVICE ...]" >&2
    exit 2
fi

output_directory=$1
shift
services=("$@")

if ! mkdir -p "$output_directory"; then
    echo "Could not create log output directory: ${output_directory}" >&2
    exit 1
fi

warnings_file="${output_directory}/collection-warnings.log"
: > "$warnings_file"

warn() {
    local message=$1

    echo "Warning: ${message}" >&2
    echo "$message" >> "$warnings_file"
}

capture_command() {
    local destination=$1
    local description=$2
    shift 2

    mkdir -p "$(dirname "$destination")"
    if ! "$@" > "$destination" 2>&1; then
        warn "Could not collect ${description}; see ${destination}"
    fi
}

capture_mysql_configuration_source() {
    local container_id=$1
    local destination=$2

    # The command is intentionally expanded inside the container.
    # shellcheck disable=SC2016
    capture_command \
        "$destination" \
        "MySQL configuration-source metadata" \
        podman exec --user root "$container_id" bash -c '
            set -euo pipefail

            if command -v mysql > /dev/null 2>&1; then
                mysql_client=mysql
            elif command -v mariadb > /dev/null 2>&1; then
                mysql_client=mariadb
            else
                echo "A MySQL-compatible client is unavailable" >&2
                exit 1
            fi

            mysql_command=()
            if [[ -r /root/.my.cnf ]] &&
                "$mysql_client" --defaults-file=/root/.my.cnf \
                    --connect-timeout=5 \
                    --execute="SELECT 1" > /dev/null 2>&1
            then
                mysql_command=(
                    "$mysql_client"
                    --defaults-file=/root/.my.cnf
                    --connect-timeout=5
                )
            elif "$mysql_client" --no-defaults --user=root \
                --connect-timeout=5 \
                --execute="SELECT 1" > /dev/null 2>&1
            then
                mysql_command=(
                    "$mysql_client"
                    --no-defaults
                    --user=root
                    --connect-timeout=5
                )
            else
                echo "Could not connect to the database as root" >&2
                exit 1
            fi

            "${mysql_command[@]}" --table \
                --execute="SELECT VERSION() AS database_version"

            mysql_variables_info_exists=$(
                "${mysql_command[@]}" --batch --skip-column-names \
                    --execute="
                        SELECT COUNT(*)
                        FROM information_schema.tables
                        WHERE table_schema = '\''performance_schema'\''
                          AND LOWER(table_name) = '\''variables_info'\''
                    "
            )
            if [[ $mysql_variables_info_exists == 1 ]]; then
                "${mysql_command[@]}" --table --execute="
                    SELECT
                        gv.VARIABLE_NAME,
                        gv.VARIABLE_VALUE,
                        vi.VARIABLE_SOURCE,
                        vi.VARIABLE_PATH,
                        vi.SET_TIME,
                        vi.SET_USER,
                        vi.SET_HOST
                    FROM performance_schema.global_variables AS gv
                    JOIN performance_schema.variables_info AS vi
                        USING (VARIABLE_NAME)
                    WHERE gv.VARIABLE_NAME IN (
                        '\''log_error'\'',
                        '\''max_connections'\'',
                        '\''open_files_limit'\'',
                        '\''table_open_cache'\''
                    )
                    ORDER BY gv.VARIABLE_NAME
                "
                exit 0
            fi

            mariadb_system_variables_exists=$(
                "${mysql_command[@]}" --batch --skip-column-names \
                    --execute="
                        SELECT COUNT(*)
                        FROM information_schema.tables
                        WHERE table_schema = '\''information_schema'\''
                          AND LOWER(table_name) = '\''system_variables'\''
                    "
            )
            if [[ $mariadb_system_variables_exists == 1 ]]; then
                "${mysql_command[@]}" --table --execute="
                    SELECT
                        VARIABLE_NAME,
                        GLOBAL_VALUE AS VARIABLE_VALUE,
                        GLOBAL_VALUE_ORIGIN AS VARIABLE_SOURCE,
                        DEFAULT_VALUE
                    FROM information_schema.SYSTEM_VARIABLES
                    WHERE LOWER(VARIABLE_NAME) IN (
                        '\''log_error'\'',
                        '\''max_connections'\'',
                        '\''open_files_limit'\'',
                        '\''table_open_cache'\''
                    )
                    ORDER BY VARIABLE_NAME
                "
            else
                echo
                echo "Database configuration-source metadata is unavailable"
            fi
        '
}

container_ids=()
if command -v podman-compose > /dev/null 2>&1; then
    capture_command \
        "${output_directory}/compose-ps.log" \
        "Compose status" \
        podman-compose ps
    capture_command \
        "${output_directory}/compose.log" \
        "Compose logs" \
        podman-compose logs --no-color

    if compose_container_ids=$(
        podman-compose ps --quiet 2>> "$warnings_file"
    ); then
        while IFS= read -r container_id; do
            if [[ -n $container_id ]]; then
                container_ids+=("$container_id")
            fi
        done <<< "$compose_container_ids"
    else
        warn "Could not find Compose containers"
    fi
else
    warn "podman-compose is unavailable"
fi

find_service_container() {
    local service=$1
    local container_id
    local service_label

    for container_id in "${container_ids[@]}"; do
        if ! service_label=$(
            podman inspect \
                --format \
                '{{ index .Config.Labels "io.podman.compose.service" }}' \
                "$container_id" 2>> "$warnings_file"
        ); then
            continue
        fi
        if [[ $service_label == "$service" ]]; then
            echo "$container_id"
            return 0
        fi
    done

    return 1
}

copy_container_path() {
    local container_id=$1
    local service=$2
    local source=$3
    local running=$4
    local destination="${output_directory}/${service}/files${source}"

    if [[ $running == "true" ]] \
        && ! podman exec --user root "$container_id" \
            test -e "$source" > /dev/null 2>&1; then
        warn "${service}: ${source} is unavailable"
        return
    fi

    mkdir -p "$(dirname "$destination")"
    if ! podman cp \
        "${container_id}:${source}" "$destination" \
        2>> "$warnings_file"; then
        warn "${service}: could not copy ${source}"
    fi
}

archivematica_log_paths=(
    "/var/log/archivematica"
    "/var/log/mysql"
    "/var/log/mysqld.log"
    "/var/log/elasticsearch"
    "/var/log/gearman-job-server"
    "/var/log/clamav"
    "/var/log/nginx"
)

for service in "${services[@]}"; do
    service_directory="${output_directory}/${service}"
    mkdir -p "$service_directory"

    if ! container_id=$(find_service_container "$service"); then
        warn "${service}: container is unavailable"
        continue
    fi

    capture_command \
        "${service_directory}/container.log" \
        "${service} container output" \
        podman logs "$container_id"

    if ! running=$(
        podman inspect --format '{{ .State.Running }}' \
            "$container_id" 2>> "$warnings_file"
    ); then
        warn "${service}: could not inspect container state"
        continue
    fi
    if [[ $running != "true" ]]; then
        warn "${service}: container is not running"
    else
        capture_command \
            "${service_directory}/journal.log" \
            "${service} systemd journal" \
            podman exec --user root "$container_id" \
                journalctl --no-pager
        capture_command \
            "${service_directory}/failed-units.log" \
            "${service} failed systemd units" \
            podman exec --user root "$container_id" \
                systemctl --failed --no-pager --full
        if [[ $service == "archivematica" ]]; then
            capture_mysql_configuration_source \
                "$container_id" \
                "${service_directory}/mysql-configuration-source.log"
        fi
    fi

    if [[ $service == "archivematica" ]]; then
        for source in "${archivematica_log_paths[@]}"; do
            copy_container_path \
                "$container_id" "$service" "$source" "$running"
        done
    fi
done
