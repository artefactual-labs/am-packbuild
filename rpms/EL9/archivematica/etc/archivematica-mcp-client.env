PATH=/usr/share/archivematica/virtualenvs/archivematica/bin:/usr/local/sbin:/sbin:/bin:/usr/sbin:/usr/bin:/root/bin
PYTHONPATH=/usr/lib/:/usr/share/
LANG="en_US.UTF-8"
LC_ALL="en_US.UTF-8"
LC_LANG="en_US.UTF-8"

DJANGO_SETTINGS_MODULE=archivematica.MCPClient.settings.common

